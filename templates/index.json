        "166442457738b23caf-0": {
          "type": "item",
          "settings": {
            "title": "Comment passer une commande ?",
            "content": "<p>Sélectionne les articles que tu souhaites, choisis ta taille et ta couleur, puis ajoute-les au panier. Il ne te reste plus qu’à valider ta commande en suivant les étapes de paiement sécurisé.</p>"
          }
        },
        "item_jCULgf": {
          "type": "item",
          "settings": {
            "title": "Comment entretenir mes vêtements de sport ?",
            "content": "<p>- Lavage à froid (30°C max)<br/>- Ne pas utiliser de sèche-linge<br/>- Ne pas repasser<br/>- Éviter l’assouplissant pour préserver l’élasticité</p>"
          }
        },
        "item_jDPeEA": {
          "type": "item",
          "settings": {
            "title": "Puis-je modifier ou annuler ma commande après validation ?",
            "content": "<p>Une fois la commande confirmée, elle est traitée rapidement. Si tu souhaites la modifier ou l’annuler, contacte-nous au plus vite via le service client. Nous ferons notre possible selon l’état de préparation.</p>"
          }
        },
        "item_nYrHdX": {
          "type": "item",
          "settings": {
            "title": "Quels sont les délais de livraison ?",
            "content": "<p>Les délais de livraison sont généralement de <strong>4 à 5 jours ouvrés</strong>. Un email de confirmation avec numéro de suivi te sera envoyé dès l’expédition.</p>"
          }
        },
        "item_3QNiRi": {
          "type": "item",
          "settings": {
            "title": "Livrez-vous à l’international ?",
            "content": "<p>Oui. Les frais et délais peuvent varier selon le pays de destination.</p>"
