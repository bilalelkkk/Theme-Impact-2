        },
        "item_3jtHCR": {
          "type": "item",
          "settings": {
            "title": "Les vêtements conviennent-ils à tous les types de sport ?",
            "content": "<p>Oui ! Nos pièces sont adaptées au fitness, musculation, yoga, pilates, running et au quotidien (lifestyle).</p>"
          }
        },
        "166442457738b23caf-1": {
