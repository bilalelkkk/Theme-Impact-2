        },
        "item_yzdmhP": {
          "type": "item",
          "settings": {
            "title": "Comment choisir la bonne taille ?",
            "content": "<p>Un guide des tailles est disponible sur chaque fiche produit. Si tu hésites entre deux tailles, nous conseillons généralement de prendre la plus grande pour plus de confort.</p>"
          }
        },
        "item_VmgA4P": {
          "type": "item",
          "settings": {
            "title": "Les leggings sont-ils transparents ?",
            "content": "<p>Non. Nos leggings sont conçus avec des tissus <strong>opaques, épais et testés au squat</strong>, pour t’offrir un maximum de confiance pendant l’entraînement.</p>"
